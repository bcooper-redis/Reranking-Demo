REDIS_URL=redis://redis:6379
REDIS_PORT=6379
REDIS_INDEX_ALIAS=demo:giftcards
REDIS_INDEX_VERSION=v1
REDIS_VECTOR_ALGORITHM=flat

EMBEDDING_PROVIDER=local_hf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMS=384
EMBEDDING_CACHE_TTL_SECONDS=3600

ROUTER_NAME=demo:routes
ROUTER_TIMEOUT_MS=30000

RERANKER_PROVIDER=local_hf
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=20
RERANK_TIMEOUT_MS=250

PERSONALIZATION_AFFINITY_WEIGHT=0.10
PROMOTION_RELEVANCE_WEIGHT=0.08
POPULARITY_TIEBREAKER_WEIGHT=0.02
POLICY_TOTAL_MAX_BOOST=0.12

SEARCH_LIMIT_DEFAULT=10
SEARCH_CANDIDATE_COUNT=25
SEARCH_RRF_K=60
ENABLE_DEBUG=true
ADMIN_TOKEN=change-me
APP_ENV=local

FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

REDIS_MAX_CONNECTIONS=20
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=5

# Optional paid providers, disabled unless explicitly configured.
COHERE_API_KEY=
VOYAGE_API_KEY=
